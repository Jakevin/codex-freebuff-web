{
  "name": "codex-freebuff-web",
  "version": "5.0.1",
  "private": true,
  "description": "A local Responses bridge for Freebuff's official free CLI session and Web Chat entry point.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jakevin/codex-freebuff-web.git"
  },
  "homepage": "https://github.com/Jakevin/codex-freebuff-web#readme",
  "bugs": {
    "url": "https://github.com/Jakevin/codex-freebuff-web/issues"
  },
  "packageManager": "bun@1.4.0",
  "type": "module",
  "bin": {
    "codex-freebuff-web": "./src/cli.ts",
    "codex-chatgpt-web": "./src/cli.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSES"
  ],
  "scripts": {
    "start": "bun run src/cli.ts serve",
    "setup": "bun run src/cli.ts setup",
    "doctor": "bun run src/cli.ts doctor",
    "test": "bun test tests/freebuff.test.ts",
    "test:legacy": "bun test tests/*.test.ts",
    "audit": "bun audit",
    "check-version": "bun run scripts/check-version.ts",
    "typecheck": "bunx tsc --noEmit",
    "licenses": "bun run scripts/generate-third-party-notices.ts",
    "clean": "bun run scripts/clean.ts",
    "build": "bun run scripts/build-runtime-bundle.ts",
    "smoke": "bun run scripts/smoke-release.ts dist/runtime",
    "verify": "bun run scripts/verify.ts"
  },
  "dependencies": {
    "@codebuff/sdk": "^0.10.7",
    "tiktoken": "1.0.22",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/bun": "1.4.0",
    "@types/turndown": "5.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "chromium-bidi": "12.1.0",
    "fflate": "^0.8.2",
    "playwright-core": "^1.62.0",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "fast-uri": "3.1.6",
    "hono": "4.12.34",
    "qs": "6.16.0",
    "zod-to-json-schema": "3.25.1"
  },
  "keywords": [
    "codex",
    "freebuff",
    "codebuff",
    "responses-api",
    "coding-agent"
  ],
  "license": "MIT"
}
